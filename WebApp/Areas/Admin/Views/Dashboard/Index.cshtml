@{
    ViewData["Title"] = "Dashboard";
    List<KeyValuePair<string, long>>? topPaths = ViewBag.TopPaths as List<KeyValuePair<string, long>>;
}

<h2>Panel administracyjny</h2>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Książki</h5>
                <p class="card-text display-6">@ViewBag.BooksCount</p>
                <a asp-area="" asp-controller="Book" asp-action="Index" class="btn btn-primary btn-sm">Lista książek</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Autorzy</h5>
                <p class="card-text display-6">@ViewBag.AuthorsCount</p>
                <a asp-area="Admin" asp-controller="Authors" asp-action="Index" class="btn btn-primary btn-sm">Zarządzaj autorami</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Wszystkie żądania</h5>
                <p class="card-text display-6">@ViewBag.TotalRequests</p>
            </div>
        </div>
    </div>
</div>

<h4 class="mt-4">5 najpopularniejszych ścieżek</h4>
@if (topPaths != null && topPaths.Count > 0)
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Ścieżka</th>
                <th>Liczba żądań</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in topPaths)
            {
                <tr>
                    <td><code>@item.Key</code></td>
                    <td>@item.Value</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">Brak zarejestrowanych żądań.</p>
}

<a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-secondary">Powrót do strony głównej</a>
