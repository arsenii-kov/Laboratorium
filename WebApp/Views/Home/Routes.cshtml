@model List<WebApp.Models.RouteInfoViewModel>
@{
    ViewData["Title"] = "Tabela tras";
}

<h2>Tabela adresów aplikacji</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Adres</th>
            <th>Kontroler.Akcja</th>
            <th>Metoda HTTP</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td><code>@r.Url</code></td>
                <td>@r.Action</td>
                <td>@r.HttpMethods</td>
            </tr>
        }
    </tbody>
</table>
